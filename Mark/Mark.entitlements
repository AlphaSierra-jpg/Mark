<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Deliberately unsandboxed. Mark renders a generated HTML shell from a
	  temporary directory while its relative images live next to the document,
	  and granting WebKit read access across both is what makes relative paths
	  work without asking the reader to approve each folder. This is a personal
	  tool, not an App Store build.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
